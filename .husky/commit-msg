#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

commit_msg=$(cat "$1")
pattern="^(feat|fix|chore|docs|style|refactor|test|build|ci)(\(.+\))?: .{1,100}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌ Invalid commit message format."
  echo "   Use Conventional Commits: feat(scope): description"
  echo "   Allowed types: feat, fix, chore, docs, style, refactor, test, build, ci"
  echo ""
  exit 1
fi
